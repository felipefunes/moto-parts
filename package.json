{
  "name": "moto-parts-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --mode motos",
    "build": "tsc -b && vite build --mode motos",
    "dev:motos": "vite --mode motos",
    "build:motos": "tsc -b && vite build --mode motos",
    "dev:carteras": "vite --mode carteras",
    "build:carteras": "tsc -b && vite build --mode carteras",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:api-types": "openapi-typescript http://localhost:8080/v3/api-docs -o src/services/api/generated/types.ts",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test:e2e:fast": "playwright test --config=e2e/playwright.fast.config.ts",
    "test:e2e:fast:report": "playwright show-report e2e/playwright-report-fast"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/orbitron": "^5.1.0",
    "@fontsource/rajdhani": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
